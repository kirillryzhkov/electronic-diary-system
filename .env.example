# Copy to .env for Docker Compose and fill the blank secrets before starting.
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Compose sets POSTGRES_HOST=db. Set a host explicitly if running Django
# outside Compose with PostgreSQL. An unset host selects local SQLite.
POSTGRES_DB=diary
POSTGRES_USER=diary
POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Optional. Leave empty to disable Telegram delivery.
TELEGRAM_BOT_TOKEN=
